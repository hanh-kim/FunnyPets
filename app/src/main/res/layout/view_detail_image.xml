<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="model"
            type="com.hpk.funnypet.model.Photo" />
    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardCornerRadius="6dp"
        app:cardElevation="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/main_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_detail_photo"
                src_image_url="@{model.getUrl()}"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                tools:layout_editor_absoluteX="-16dp"
                tools:layout_editor_absoluteY="-25dp"
                tools:src="@drawable/cell_image_error" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_margin="12dp"
                android:padding="12dp"
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/overlay_black"
                android:text="@{model.title}"
                android:textColor="@color/white"
                app:layout_constraintBottom_toBottomOf="@+id/iv_detail_photo"
                tools:text="kkkkkkkkkkkkkk" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

</layout>
